{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instantane-1.schema.json",
  "title": "Instantané — un graphe à une date",
  "description": "public/api/instantanes/<id>.json. Contrat : docs/brique0/contrats.md §4.2 et §4.3. Aucun nombre n'est atteignable en dehors d'un marqueur, hors `effectif` : il n'existe pas d'emplacement pour une valeur agrégeant deux familles (I11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contrat", "id", "chambre", "legislature", "date", "date_arretee", "ancrage", "bandes", "sans_mesure"],
  "properties": {
    "schema": { "const": "contrepoint/instantane/1" },
    "contrat": { "$ref": "preuve-1.schema.json#/$defs/semver" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "chambre": { "enum": ["AN"] },
    "legislature": { "type": "string", "pattern": "^[0-9]{1,2}$" },
    "date": {
      "$ref": "preuve-1.schema.json#/$defs/date",
      "description": "Date de référence de l'agrégation. Un groupe dont la période de validité ne la couvre pas est absent, jamais présent avec un effectif résiduel (ingestion-votes.md §8)."
    },
    "date_arretee": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ancrage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["famille", "ancre_gauche", "ancre_droite", "note"],
      "description": "Porté comme donnée et non comme texte d'interface : c'est lui qui rend fausse la superposition de deux instantanés. `ancre_gauche` et `ancre_droite` sont recopiés du champ `ancre_axe` du registre d'entités, valide à `date` — jamais dérivés d'un identifiant d'échelle, qui n'encode que la convention d'ancrage (contrats.md §2.3), et jamais choisis par le pipeline : une ancre absente à cette date l'arrête (V25, RG-31).",
      "properties": {
        "famille": { "type": "string", "pattern": "^[a-z_]+$" },
        "ancre_gauche": { "type": "string", "pattern": "^groupe\\.an[0-9]{2}\\.[a-z0-9-]+$" },
        "ancre_droite": { "type": "string", "pattern": "^groupe\\.an[0-9]{2}\\.[a-z0-9-]+$" },
        "note": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    },
    "bandes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle", "marqueurs"],
        "properties": {
          "id": { "$ref": "preuve-1.schema.json#/properties/entite" },
          "libelle": { "type": "string", "minLength": 1, "maxLength": 40 },
          "marqueurs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/marqueur" }
          }
        }
      }
    },
    "sans_mesure": {
      "type": "array",
      "description": "Entités dont aucun marqueur ne porte de valeur et dont aucun ne relève d'une non-publication motivée. Dites, pas comblées, et pas dessinées.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entite", "libelle", "motif_code", "motif"],
        "properties": {
          "entite": { "$ref": "preuve-1.schema.json#/properties/entite" },
          "libelle": { "type": "string", "minLength": 1, "maxLength": 40 },
          "motif_code": { "$ref": "preuve-1.schema.json#/properties/motif_code" },
          "motif": { "type": "string", "minLength": 1, "maxLength": 140 }
        }
      }
    }
  },
  "$defs": {
    "marqueur": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "description": "I6 — valeur et code jamais tous deux présents. Recopié de preuve-1.schema.json : l'instantané est le seul fichier que le front lit, un marqueur qui passe ici sans passer là s'afficherait « non mesuré » sans motif.",
          "not": {
            "properties": {
              "valeur": { "type": "number" },
              "valeur_code": { "type": "string" }
            },
            "required": ["valeur", "valeur_code"]
          }
        },
        {
          "description": "I6 — absence dite : ni valeur ni code implique motif_code et motif.",
          "if": {
            "properties": { "valeur": { "type": "null" }, "valeur_code": { "type": "null" } }
          },
          "then": {
            "properties": {
              "motif_code": { "type": "string" },
              "motif": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": { "motif_code": { "type": "null" }, "motif": { "type": "null" } }
          }
        }
      ],
      "required": ["famille", "echelle", "valeur", "valeur_code", "libelle", "motif_code", "motif", "dispersion", "preuve"],
      "description": "Une famille, une échelle, une valeur. Chaque marqueur a sa propre graduation ; aucune graduation commune, donc aucun écart entre familles à calculer.",
      "properties": {
        "famille": { "type": "string", "pattern": "^[a-z_]+$" },
        "echelle": { "type": "string", "minLength": 1 },
        "valeur": { "type": ["number", "null"] },
        "valeur_code": { "type": ["string", "null"], "minLength": 1 },
        "libelle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "motif_code": { "$ref": "preuve-1.schema.json#/properties/motif_code" },
        "motif": { "$ref": "preuve-1.schema.json#/$defs/phrase" },
        "dispersion": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["effectif", "iqr"],
          "description": "Réduite à ce qui s'affiche. La dispersion complète vit dans la ligne de preuve.",
          "properties": {
            "effectif": { "type": "integer", "minimum": 0 },
            "iqr": { "type": "number", "minimum": 0 }
          }
        },
        "preuve": {
          "$ref": "preuve-1.schema.json#/$defs/sha256",
          "description": "`id` de la ligne du registre. Le chemin de l'éclat en dérive : preuves/<deux premiers caractères>.json."
        }
      }
    }
  }
}
