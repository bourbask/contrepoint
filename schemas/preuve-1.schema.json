{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preuve-1.schema.json",
  "title": "Ligne du registre de preuves",
  "description": "Une ligne = une position mesurée. Contrat : docs/brique0/contrats.md §2. Ce schéma ne peut pas exprimer l'ordre des clés (§7), le calcul de `id` (§3) ni les invariants I1 à I18 (§6) : le validateur du pipeline les vérifie en plus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "contrat", "famille", "entite", "valeur", "valeur_code", "echelle", "motif_code", "motif", "dispersion", "observation", "date_source", "date_calcul", "methode", "epingles", "entrees", "logiciel"],
  "properties": {
    "schema": { "const": "contrepoint/preuve/1" },
    "id": { "$ref": "#/$defs/sha256" },
    "contrat": { "$ref": "#/$defs/semver" },
    "famille": { "enum": ["votes", "experts", "administratif"] },
    "entite": {
      "type": "string",
      "pattern": "^(parti|coalition)\\.[a-z0-9-]+$|^groupe\\.an[0-9]{2}\\.[a-z0-9-]+$",
      "description": "`id` du registre d'entités. Aucun identifiant de personne : voir I13."
    },
    "valeur": { "type": ["number", "null"] },
    "valeur_code": { "type": ["string", "null"], "minLength": 1 },
    "echelle": { "$ref": "#/$defs/echelle" },
    "motif_code": {
      "enum": ["hors_source", "sous_seuil_de_publication", "source_indeterminee", "source_non_recuperable", null]
    },
    "motif": { "$ref": "#/$defs/phrase" },
    "dispersion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["effectif", "iqr", "ecart_type_reechantillonnage"],
      "properties": {
        "effectif": { "type": "integer", "minimum": 0 },
        "iqr": { "type": "number", "minimum": 0 },
        "ecart_type_reechantillonnage": { "type": "number", "minimum": 0 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debut", "fin"],
      "description": "Période décrite par la mesure, bornes incluses. Pour la famille `votes`, `fin` est aussi la date de référence de l'agrégation (ingestion-votes.md §8).",
      "properties": {
        "debut": { "$ref": "#/$defs/date" },
        "fin": { "$ref": "#/$defs/date" }
      }
    },
    "date_source": { "$ref": "#/$defs/date" },
    "date_calcul": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Fournie par l'environnement, jamais lue sur une horloge. Hors de la clé de déduplication."
    },
    "methode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "parametres"],
      "properties": {
        "id": { "enum": ["votes_rang1_ancre", "ches_lrgen", "nuance_constatee"] },
        "version": {
          "$ref": "#/$defs/semver",
          "description": "Tout changement susceptible de déplacer une valeur l'incrémente. Voir I8."
        },
        "parametres": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9_]+$" },
          "additionalProperties": {
            "anyOf": [
              { "type": ["string", "number", "boolean"] },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "epingles": {
      "type": "array",
      "description": "Fonctions fixes externes épinglées en version (ADR 0000 §6, règle 4). Vide en brique 0.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nom", "version"],
        "properties": {
          "nom": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "description": "Triée par `empreinte_sha256`. Aucune position sans source empreintée et datée.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "url", "empreinte_sha256", "recupere_le"],
        "properties": {
          "source": {
            "enum": ["an_scrutins_17", "an_organe", "an_parpol_mandats", "ches_2024", "ches_trend", "manifesto", "nuance_leg2024", "parlgov", "wikidata", "declaration_publique", "registre_partis"]
          },
          "url": { "type": "string", "format": "uri" },
          "empreinte_sha256": { "$ref": "#/$defs/sha256" },
          "recupere_le": { "$ref": "#/$defs/date" }
        }
      }
    },
    "logiciel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    }
  },
  "allOf": [
    {
      "description": "I6 — valeur et code jamais tous deux présents.",
      "not": {
        "properties": {
          "valeur": { "type": "number" },
          "valeur_code": { "type": "string" }
        },
        "required": ["valeur", "valeur_code"]
      }
    },
    {
      "description": "I6 — absence dite : ni valeur ni code implique motif_code et motif.",
      "if": {
        "properties": { "valeur": { "type": "null" }, "valeur_code": { "type": "null" } }
      },
      "then": {
        "properties": {
          "motif_code": { "type": "string" },
          "motif": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "properties": { "motif_code": { "type": "null" }, "motif": { "type": "null" } }
      }
    },
    {
      "description": "§2.2 — l'objet mesuré dépend de la famille, et §2.3 — une échelle par famille.",
      "if": { "properties": { "famille": { "const": "votes" } }, "required": ["famille"] },
      "then": {
        "properties": {
          "entite": { "pattern": "^groupe\\." },
          "echelle": { "properties": { "id": { "const": "votes_lfi_rn" } } }
        }
      }
    },
    {
      "if": { "properties": { "famille": { "const": "experts" } }, "required": ["famille"] },
      "then": {
        "properties": {
          "entite": { "pattern": "^(parti|coalition)\\." },
          "echelle": { "properties": { "id": { "const": "ches_lrgen_0_10" } } },
          "valeur_code": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "famille": { "const": "administratif" } }, "required": ["famille"] },
      "then": {
        "properties": {
          "entite": { "pattern": "^(parti|coalition)\\." },
          "echelle": { "properties": { "id": { "const": "nuance_leg2024" } } },
          "valeur": { "type": "null" }
        }
      }
    },
    {
      "description": "§2.4 — dispersion sans valeur n'est admise qu'en non-publication motivée.",
      "if": {
        "properties": { "valeur": { "type": "null" }, "dispersion": { "type": "object" } },
        "required": ["valeur", "dispersion"]
      },
      "then": { "properties": { "motif_code": { "const": "sous_seuil_de_publication" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "phrase": {
      "type": ["string", "null"],
      "maxLength": 140,
      "description": "Une phrase, 140 caractères au plus (ADR 0000 §5)."
    },
    "echelle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "decimales", "libelle"],
      "description": "Liste close. `min` et `max` sont les bornes de graduation : une valeur en dehors est un refus. L'identifiant encode l'ancrage — inverser le signe crée `votes_rn_lfi`, il ne redéfinit pas `votes_lfi_rn`.",
      "properties": {
        "id": { "enum": ["votes_lfi_rn", "ches_lrgen_0_10", "nuance_leg2024"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "decimales": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
        "libelle": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    }
  }
}
